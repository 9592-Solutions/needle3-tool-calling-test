[
  {
    "type": "function",
    "function": {
      "name": "set_alarm",
      "description": "Set an alarm (wake me up) at a clock time, on a date if one is given.",
      "parameters": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "clock time in 24-hour HH:MM, e.g. 07:30 for 7:30 am or 19:30 for 7:30 pm"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date YYYY-MM-DD, e.g. 2026-06-12"
          }
        },
        "required": [
          "time"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "remove_alarm",
      "description": "Remove (cancel, delete, turn off) the alarm set at a clock time, on a date if one is given.",
      "parameters": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "clock time in 24-hour HH:MM, e.g. 07:30 for 7:30 am or 19:30 for 7:30 pm"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date YYYY-MM-DD, e.g. 2026-06-12"
          }
        },
        "required": [
          "time"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_list_item",
      "description": "Add one item to the shopping list, the to-do list or the packing list.",
      "parameters": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "shopping",
              "to-do",
              "packing"
            ],
            "description": "shopping (grocery, groceries), to-do (to do, tasks) or packing (trip, travel)"
          },
          "item": {
            "type": "string",
            "description": "the one item, in the user's words, e.g. two bottles of milk"
          }
        },
        "required": [
          "list",
          "item"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "remove_list_item",
      "description": "Remove (take off, delete) one item from the shopping list, the to-do list or the packing list.",
      "parameters": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "shopping",
              "to-do",
              "packing"
            ],
            "description": "shopping (grocery, groceries), to-do (to do, tasks) or packing (trip, travel)"
          },
          "item": {
            "type": "string",
            "description": "the one item, in the user's words, e.g. two bottles of milk"
          }
        },
        "required": [
          "list",
          "item"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_reminder",
      "description": "Create a reminder (remind me, don't let me forget) at a clock time on a date.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "what to be reminded about, in the user's words, e.g. take the bins out"
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "clock time in 24-hour HH:MM, e.g. 07:30 for 7:30 am or 19:30 for 7:30 pm",
            "default": "09:00"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date YYYY-MM-DD, e.g. 2026-06-12"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "start_timer",
      "description": "Start a countdown timer for a length of time.",
      "parameters": {
        "type": "object",
        "properties": {
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400,
            "description": "the length in seconds"
          }
        },
        "required": [
          "duration_seconds"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "send_message",
      "description": "Send a text message to a contact.",
      "parameters": {
        "type": "object",
        "properties": {
          "contact": {
            "type": "string",
            "description": "the contact's name"
          },
          "message": {
            "type": "string",
            "description": "the message, in the user's words"
          }
        },
        "required": [
          "contact",
          "message"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_event",
      "description": "Add an event to the calendar.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "the event title"
          },
          "date": {
            "type": "string",
            "description": "ISO date YYYY-MM-DD",
            "format": "date"
          },
          "time": {
            "type": "string",
            "description": "24-hour HH:MM",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        },
        "required": [
          "title",
          "date"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "take_note",
      "description": "Save a note.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "the note, in the user's words"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "play_music",
      "description": "Play music by an artist or of a genre.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "artist, song or genre"
          }
        },
        "required": [
          "query"
        ]
      }
    }
  }
]
