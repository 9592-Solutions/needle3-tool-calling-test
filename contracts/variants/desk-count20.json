[
  {
    "type": "function",
    "function": {
      "name": "set_alarm",
      "description": "Set an alarm (wake me up) at a clock time, on a date if one is given.",
      "parameters": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "clock time in 24-hour HH:MM, e.g. 07:30 for 7:30 am or 19:30 for 7:30 pm"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date YYYY-MM-DD, e.g. 2026-06-12"
          }
        },
        "required": [
          "time"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "remove_alarm",
      "description": "Remove (cancel, delete, turn off) the alarm set at a clock time, on a date if one is given.",
      "parameters": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "clock time in 24-hour HH:MM, e.g. 07:30 for 7:30 am or 19:30 for 7:30 pm"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date YYYY-MM-DD, e.g. 2026-06-12"
          }
        },
        "required": [
          "time"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "add_list_item",
      "description": "Add one item to the shopping list, the to-do list or the packing list.",
      "parameters": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "shopping",
              "to-do",
              "packing"
            ],
            "description": "shopping (grocery, groceries), to-do (to do, tasks) or packing (trip, travel)"
          },
          "item": {
            "type": "string",
            "description": "the one item, in the user's words, e.g. two bottles of milk"
          }
        },
        "required": [
          "list",
          "item"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "remove_list_item",
      "description": "Remove (take off, delete) one item from the shopping list, the to-do list or the packing list.",
      "parameters": {
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "shopping",
              "to-do",
              "packing"
            ],
            "description": "shopping (grocery, groceries), to-do (to do, tasks) or packing (trip, travel)"
          },
          "item": {
            "type": "string",
            "description": "the one item, in the user's words, e.g. two bottles of milk"
          }
        },
        "required": [
          "list",
          "item"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "create_reminder",
      "description": "Create a reminder (remind me, don't let me forget) at a clock time on a date.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "what to be reminded about, in the user's words, e.g. take the bins out"
          },
          "time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "clock time in 24-hour HH:MM, e.g. 07:30 for 7:30 am or 19:30 for 7:30 pm",
            "default": "09:00"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "ISO date YYYY-MM-DD, e.g. 2026-06-12"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  },
  {
