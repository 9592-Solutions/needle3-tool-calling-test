              "kitchen",
              "bedroom",
              "bathroom",
              "hallway",
              "study",
              "whole house",
              "this room"
            ],
            "description": "the room to clean when starting: living room, kitchen, bedroom, bathroom, hallway, study, whole house, or this room",
