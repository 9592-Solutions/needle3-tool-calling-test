[
  {
    "type": "function",
    "function": {
      "name": "set_lights_power",
      "description": "Turn a room's lights on or off (switch on, switch off, turn out).",
      "parameters": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "enum": [
              "living room",
              "kitchen",
              "bedroom",
              "bathroom",
              "hallway",
              "study",
              "whole house",
              "this room"
            ],
            "description": "The room whose lights change: living room (lounge), kitchen, bedroom, bathroom, hallway (hall), study, whole house (every room, all the lights), or this room (the room the user is in).",
            "default": "this room"
          },
          "power": {
            "type": "string",
            "enum": [
              "on",
              "off"
            ],
            "description": "on or off"
          }
        },
        "required": [
          "power"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_lights_brightness",
      "description": "Set a room's lights to a brightness percentage from 1 to 100 (full or max is 100, half is 50).",
      "parameters": {
        "type": "object",
        "properties": {
          "room": {
            "type": "string",
            "enum": [
              "living room",
              "kitchen",
              "bedroom",
              "bathroom",
              "hallway",
              "study",
              "whole house",
              "this room"
            ],
            "description": "The room whose lights change: living room (lounge), kitchen, bedroom, bathroom, hallway (hall), study, whole house (every room, all the lights), or this room (the room the user is in).",
            "default": "this room"
          },
          "brightness": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "brightness in percent, a whole number from 1 to 100"
          }
        },
        "required": [
          "brightness"
        ]
      }
    }
  },
